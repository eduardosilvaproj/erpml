# Exemplo de variáveis de ambiente para o sistema Stovix

# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mercado Livre (obtidas no Painel de Desenvolvedores do ML)
# Estas variáveis são usadas principalmente nas Edge Functions do Supabase
# No frontend, as URLs de autenticação são geradas dinamicamente via Edge Function
VITE_ML_APP_ID=8123456789012345
VITE_ML_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude / AI Gateway
# Usada nas Edge Functions para chamadas de IA
VITE_CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Asaas (Gateway de Pagamento)
# Usada nas Edge Functions para processamento de assinaturas
VITE_ASAAS_API_KEY=$a...xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
