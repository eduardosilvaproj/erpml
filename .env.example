# Variáveis de Ambiente - Stovix

# Supabase (Copie do painel do Supabase: Settings -> API)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_ANON_KEY=your_publishable_key_here # Fallback para compatibilidade

# Mercado Livre (obtidas no Painel de Desenvolvedores do ML)
# Usadas nas Edge Functions e para configuração de auth
MERCADO_LIVRE_APP_ID=your_ml_app_id_here
MERCADO_LIVRE_CLIENT_SECRET=your_ml_client_secret_here

# Claude / AI Gateway (Lovable AI Gateway)
LOVABLE_API_KEY=your_lovable_api_key_here

# Asaas (Gateway de Pagamento)
ASAAS_API_KEY=your_asaas_api_key_here

# Segurança CORS (Usada nas Edge Functions)
# Exemplo: https://seu-app.lovable.app
ALLOWED_ORIGIN=your_production_url_here
